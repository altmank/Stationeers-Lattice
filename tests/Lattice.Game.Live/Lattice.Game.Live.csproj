<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The world bridge's tests inside the game: the test kit's port suites (linked sources) run against the bridge over
    the real game, on the Lattice test instance only: the two-player client refuses to run unless the environment
    variable LATTICE_TEST_ROOT names the test instance's root folder. Never shipped. build.ps1 compiles it and does not
    run it; the live-check runner copies it into the test instance (modes bridge-new, bridge-load).
    The suites compile against a small xunit-shaped shim (Xunit.cs): the game's Mono gets no test framework.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <StationeersDir Condition="'$(StationeersDir)' == ''">$(STATIONEERS_DIR)</StationeersDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(StationeersDir)\rocketstation_Data\Managed</GameManagedDir>
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Lattice.Tests\Contracts\WorldViewContract.cs" Link="Contracts\WorldViewContract.cs" />
    <Compile Include="..\Lattice.Tests\Contracts\WorldChangesContract.cs" Link="Contracts\WorldChangesContract.cs" />
    <Compile Include="..\Lattice.Tests\Contracts\PlacementCheckContract.cs" Link="Contracts\PlacementCheckContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lattice.Api\Lattice.Api.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Lattice.Core\Lattice.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Lattice.Game\Lattice.Game.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Lattice.Api.Unity\Lattice.Api.Unity.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Lattice.Render\Lattice.Render.csproj" Private="false" />
  </ItemGroup>

  <!--
    Candidate ghost themes for the render look grid, from a consumer's own source file outside this repo:
    -p:LookThemes=<path to the .cs file> -p:LookThemesNamespace=<its namespace>. The file declares a static
    CandidateThemes.All of themes with a Name, a Look (Palette, Rules) and Effects (Rules). Without it the grid has
    the library column only.
  -->
  <PropertyGroup Condition="'$(LookThemes)' != '' And Exists('$(LookThemes)')">
    <DefineConstants>$(DefineConstants);LOOK_THEMES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(LookThemes)' != '' And Exists('$(LookThemes)')">
    <Compile Include="$(LookThemes)" Link="Themes\CandidateThemes.cs" />
    <Using Include="$(LookThemesNamespace)" Condition="'$(LookThemesNamespace)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(GameManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.ProfilerModule" HintPath="$(GameManagedDir)\UnityEngine.ProfilerModule.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(GameManagedDir)\UniTask.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(StationeersDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GameManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
  </ItemGroup>
</Project>
