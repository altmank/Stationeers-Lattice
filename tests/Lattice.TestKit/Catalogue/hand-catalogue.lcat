item ItemLabeller name=Labeller labeller=yes

piece StructureFrame kit=ItemSteelFrames option=0 grid=large
  step entry=ItemSteelFrames material=ItemSteelFrames*1 exit=ItemWrench air=no
  step entry=ItemSteelSheets material=ItemSteelSheets*2 exit=ItemCrowbar air=no
  step entry=ItemWeldingTorch exit=ItemAngleGrinder air=yes
  step entry=ItemWeldingTorch exit=ItemAngleGrinder air=yes gravity=yes
  cell 0 0 0 centre

piece StructureFrameIron kit=ItemIronFrames option=0 grid=large
  step entry=ItemIronFrames material=ItemIronFrames*1 exit=ItemWrench air=no
  step entry=ItemIronSheets material=ItemIronSheets*1 exit=ItemCrowbar air=no
  step entry=ItemIronSheets material=ItemIronSheets*1 exit=ItemCrowbar air=yes gravity=yes
  cell 0 0 0 centre

