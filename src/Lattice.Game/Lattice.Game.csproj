<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game bridge: the only assembly that references the game, BepInEx and LaunchPad. -->
  <PropertyGroup>
    <StationeersDir Condition="'$(StationeersDir)' == ''">$(STATIONEERS_DIR)</StationeersDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(StationeersDir)\rocketstation_Data\Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(StationeersDir)\BepInEx\core</BepInExCoreDir>
    <LaunchPadDir Condition="'$(LaunchPadDir)' == ''">$(StationeersDir)\BepInEx\plugins\StationeersLaunchPad</LaunchPadDir>
    <!-- Game references resolve from their HintPath only, so no same-named assembly elsewhere can stand in. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <!-- The game's assemblies are built against its own framework; version conflicts with netstandard are expected. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lattice.Api\Lattice.Api.csproj" />
    <ProjectReference Include="..\Lattice.Core\Lattice.Core.csproj" />
    <ProjectReference Include="..\Lattice.Api.Unity\Lattice.Api.Unity.csproj" />
    <ProjectReference Include="..\Lattice.Render\Lattice.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lattice.Game.Live" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.21.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="StationeersLaunchPad" HintPath="$(LaunchPadDir)\StationeersLaunchPad.dll" Private="false" />
    <Reference Include="LaunchPadBooster" HintPath="$(LaunchPadDir)\LaunchPadBooster.dll" Private="false" />
  </ItemGroup>

  <!-- [BepInPlugin] needs the version as a constant: written from $(Version) before every compile. -->
  <Target Name="LatticeVersionSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LatticeVersionFile>$(IntermediateOutputPath)LatticeVersion.g.cs</LatticeVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(LatticeVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace Lattice.Game.EntryPoint%3B;/// &lt;summary&gt;The mod's version, as About.xml carries it.&lt;/summary&gt;;internal static class LatticeVersion { public const string Text = &quot;$(Version)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(LatticeVersionFile)" />
      <FileWrites Include="$(LatticeVersionFile)" />
    </ItemGroup>
  </Target>

  <!--
    The mod folder as it ships: About/About.xml with the version stamped, Lattice's five assemblies with
    the contract's documentation, and the drawing's shader bundle in Bundle/; nothing else. Written to artifacts/<Configuration>/Lattice after every build.
  -->
  <Target Name="Package" AfterTargets="Build">
    <PropertyGroup>
      <LatticePackageDir>$(RepoRoot)artifacts\$(Configuration)\Lattice\</LatticePackageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(LatticePackageDir)" />
    <Copy SourceFiles="About\About.xml;About\thumb.png;About\Preview.png" DestinationFolder="$(LatticePackageDir)About" />
    <XmlPoke XmlInputPath="$(LatticePackageDir)About\About.xml" Query="/ModMetadata/Version" Value="$(Version)" />
    <Copy SourceFiles="$(OutDir)Lattice.Api.dll;$(OutDir)Lattice.Api.xml;$(OutDir)Lattice.Api.Unity.dll;$(OutDir)Lattice.Api.Unity.xml;$(OutDir)Lattice.Core.dll;$(OutDir)Lattice.Render.dll;$(OutDir)Lattice.Game.dll" DestinationFolder="$(LatticePackageDir)" />
    <Copy SourceFiles="..\Lattice.Render\Bundle\lattice.shaders" DestinationFolder="$(LatticePackageDir)Bundle" />
  </Target>

  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')"
           Text="Game assemblies not found in '$(GameManagedDir)'. Set StationeersDir in Directory.Build.props.user (see Directory.Build.props.user.example) or the STATIONEERS_DIR environment variable." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll not found in '$(BepInExCoreDir)'." />
    <Error Condition="!Exists('$(LaunchPadDir)\StationeersLaunchPad.dll')" Text="StationeersLaunchPad.dll not found in '$(LaunchPadDir)'." />
  </Target>
</Project>
